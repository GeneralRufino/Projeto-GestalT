# Connection string do Neon - pegar em https://console.neon.tech
# Formato: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.neon.tech/escola_db?sslmode=require"

# Segredo para assinar tokens JWT - use uma string longa e aleatória em produção
JWT_SECRET="troque-isto-por-uma-chave-secreta-bem-longa-e-aleatoria"

# Porta da API
PORT=3333

# Origens permitidas para CORS (separadas por virgula)
CORS_ORIGINS="http://localhost:5173"

# Ambiente de execucao
NODE_ENV=development
